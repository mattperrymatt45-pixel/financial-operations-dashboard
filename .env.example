# Copy this file to .env and fill in your real values. Never commit .env.

# --- PostgreSQL (read/write - used by database/load_data.py and etl/etl_pipeline.py) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=financial_ops
DB_USER=postgres
DB_PASSWORD=postgres

# --- PostgreSQL (read-only - used by the AI assistant, see ai_assistant/setup_readonly_role.sql) ---
DB_READONLY_USER=readonly_user
DB_READONLY_PASSWORD=readonly_pass

# --- LLM (Phase 6 AI assistant + Phase 7 automated summary) ---
# Free option: Groq (https://console.groq.com/keys) - no credit card, OpenAI-compatible.
# Get a key, then set:
#   OPENAI_API_KEY=<your groq key>
#   OPENAI_BASE_URL=https://api.groq.com/openai/v1
#   OPENAI_MODEL=llama-3.3-70b-versatile
# Paid alternative: leave OPENAI_BASE_URL blank and use a real OpenAI key + gpt-4o-mini.
OPENAI_API_KEY=<your_groq_api_key>
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=llama-3.3-70b-versatile

# --- Power BI dataset refresh (Phase 7 automation) - see automation/README.md ---
PBI_TENANT_ID=
PBI_CLIENT_ID=
PBI_CLIENT_SECRET=
PBI_WORKSPACE_ID=
PBI_DATASET_ID=

# --- Email report (Phase 7 automation) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
REPORT_RECIPIENT=
